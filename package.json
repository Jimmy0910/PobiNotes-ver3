{
  "name": "pobinotes-mistake-notebook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build && powershell -Command \"if (Test-Path dist) { Add-Type -AssemblyName Microsoft.VisualBasic; [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory((Resolve-Path dist).Path, 'OnlyErrorDialogs', 'SendToRecycleBin') }; Copy-Item -Recurse -Force 'C:/Users/jimmy/AppData/Local/Temp/mistake-notebook-dist' 'dist'\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist",
    "test:e2e": "node tests/e2e/runner.js",
    "lhci:mobile": "lhci autorun --config=./lighthouserc.json",
    "lhci:desktop": "lhci autorun --config=./lighthouserc.desktop.json",
    "lhci:flow": "node scripts/test-user-flow.mjs",
    "lhci": "npm run lhci:mobile && npm run lhci:desktop"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.23.0",
    "puppeteer": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@lhci/cli": "^0.16.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "wrangler": "^4.107.0"
  }
}
